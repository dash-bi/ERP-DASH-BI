# ---------------------------------------------------------------
# Construcción anterior, superada por la app actual. Si reaparece
# dentro de esta carpeta no se publica: un segundo index.html
# competiría con el de la raíz, que es el que despliega Vercel.
# ---------------------------------------------------------------
/_version-anterior/
/Version vieja/

# --- Secretos: nunca deben llegar al repositorio ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
config.local.*

# --- Respaldos exportados desde la aplicación (contienen datos reales) ---
respaldo-erp-*.json

# --- Ruido del sistema operativo y del editor ---
Thumbs.db
desktop.ini
.DS_Store
*~
*.tmp
*.bak
.vscode/
.idea/

# ---------------------------------------------------------------
# Proyecto aparte que vive en esta carpeta (AI Studio, React+Vite).
# No es la aplicación: si llega al repositorio, Vercel detecta su
# package.json, compila con Vite y deja de publicar este index.html.
# ---------------------------------------------------------------
/package.json
/bun.lock
/vite.config.ts
/tsconfig.json
/server.ts
/metadata.json
/README.md
/src/
/erp-financiero---copiloto-inteligente/
/node_modules/
/dist/
